# Copy this file to `.env` and fill in real values locally, or set these as
# environment variables / secrets-manager entries in deployed environments.
# NEVER commit a `.env` file — it is gitignored, and this file must never
# contain a real secret, only placeholders.

# Application
APP_NAME=ApplyFlow
ENVIRONMENT=development
DEBUG=true

# Database
# Local dev defaults to the docker-compose Postgres container. For a
# provisioned Supabase project, use its connection string instead, e.g.
# postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://applyflow:applyflow@localhost:5432/applyflow
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# Supabase (database host + auth provider)
# Project URL: Supabase dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=
# JWT secret: Supabase dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
# Required whenever ENVIRONMENT is not "development".
SUPABASE_JWT_SECRET=

# Encryption at rest for sensitive fields (Epic 07 —
# src/infrastructure/security/). Contact details, citizenship, work
# authorization, EEO self-identification, resume text, and the documents sent to
# employers are AES-256-GCM encrypted in the columns that hold them. These two
# values are the only place the keys come from — there is no key in the source.
#
# FIELD_ENCRYPTION_KEYS is a comma-separated list of `key_id:base64_key` pairs,
# MOST RECENT FIRST. The first entry encrypts new writes; the rest stay loaded so
# rows written under a retired key are still readable, which is what makes a
# rotation possible without rewriting the database. Generate a key with:
#
#     openssl rand -base64 32
#
# To rotate: prepend the new key, deploy, and leave the old one in place until
# nothing decrypts under it any more (rows re-encrypt as they are next written).
#
#     FIELD_ENCRYPTION_KEYS=2026-08:<new base64 key>,2026-02:<old base64 key>
#
# FIELD_BLIND_INDEX_KEY keys the deterministic digest that keeps
# job_applications.candidate_email searchable while encrypted. Same 32-byte
# format, and deliberately NOT part of the rotating list above: changing it
# invalidates every digest already stored, so rotating it means recomputing the
# blind-index column.
#
# Both are REQUIRED whenever ENVIRONMENT is not "development". Left empty, the
# application falls back to a key committed to this repository so a fresh clone
# runs — see EncryptionKeyring.for_development, and note that rows it wrote are
# stamped with the key id "dev-insecure".
FIELD_ENCRYPTION_KEYS=
FIELD_BLIND_INDEX_KEY=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# LLM / LangChain (OpenAI — used by LangChainResumeAnalyzer)
# Required whenever ENVIRONMENT is not "development".
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
# Embeddings (Epic 00 LLM layer, src/infrastructure/llm/openai_embedding_client.py)
# Anthropic has no embeddings endpoint, so this reuses OPENAI_API_KEY above.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic — the app's single LLM integration (src/infrastructure/llm/anthropic_client.py)
# Must be a pay-as-you-go API key from https://console.anthropic.com/settings/keys.
# Never a claude.ai subscription/session login. Required whenever ENVIRONMENT is not "development".
ANTHROPIC_API_KEY=
# Model routing: callers pass a LlmTaskType (extraction/matching/parsing/
# resume_writing/cover_letter_writing), never a model name. These two
# settings are the only place to override which model answers each tier —
# see src/application/ports/llm_client_port.py (TASK_TYPE_TIERS) for the
# task-type -> tier mapping.
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_STRONG=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024
# Retry/backoff for transient errors (rate limits, timeouts, 5xxs). Retries
# happen after the initial attempt, so total attempts = MAX_RETRIES + 1.
# Delay doubles each attempt, starting at BASE and capped at MAX.
ANTHROPIC_MAX_RETRIES=3
ANTHROPIC_RETRY_BASE_DELAY_SECONDS=1.0
ANTHROPIC_RETRY_MAX_DELAY_SECONDS=20.0

# Resume file storage — local directory raw resume uploads are written to.
RESUME_STORAGE_DIR=./var/resumes

# Job aggregator integration — Adzuna (src/infrastructure/job_aggregators/adzuna_client.py)
# App id/key: https://developer.adzuna.com/ -> "Register" -> your app's dashboard.
# JOB_AGGREGATOR_APP_ID is not secret (Adzuna shows it in sample request URLs);
# JOB_AGGREGATOR_API_KEY is Adzuna's "app_key" and must stay secret.
JOB_AGGREGATOR_APP_ID=
JOB_AGGREGATOR_API_KEY=
JOB_AGGREGATOR_BASE_URL=https://api.adzuna.com/v1/api/jobs
JOB_AGGREGATOR_COUNTRY=us
JOB_AGGREGATOR_RESULTS_PER_PAGE=50
JOB_AGGREGATOR_MAX_RETRIES=3
JOB_AGGREGATOR_RETRY_BASE_DELAY_SECONDS=1.0
JOB_AGGREGATOR_RETRY_MAX_DELAY_SECONDS=20.0

# Search API integration — Tavily (src/infrastructure/search/)
# API key: https://tavily.com -> sign up -> API key (starts "tvly-").
# Replaced Brave Search, which withdrew its free tier.
# Used only to LOCATE which ATS board (Greenhouse/Lever/Ashby) a company
# posts through for job-aggregator listings missing an apply URL/description
# — never to answer a listing's fields directly, and never LinkedIn/Indeed.
# The free allowance is metered and small, so a discovered board is cached
# permanently per company and the quota is tracked in Redis so it degrades
# gracefully (skips resolution) once exhausted instead of failing. Set
# SEARCH_API_DAILY_QUOTA to match whatever your plan actually allows.
SEARCH_API_KEY=
SEARCH_API_BASE_URL=https://api.tavily.com/search
SEARCH_API_DAILY_QUOTA=100
SEARCH_API_MAX_RETRIES=3
SEARCH_API_RETRY_BASE_DELAY_SECONDS=1.0
SEARCH_API_RETRY_MAX_DELAY_SECONDS=20.0
SEARCH_API_BOARD_LOCATE_RESULT_COUNT=5

# ATS board integration — Greenhouse/Lever/Ashby public job-board APIs
# (src/infrastructure/ats_boards/). Unauthenticated public feeds — no
# credentials to configure, only retry/backoff.
ATS_BOARD_MAX_RETRIES=3
ATS_BOARD_RETRY_BASE_DELAY_SECONDS=1.0
ATS_BOARD_RETRY_MAX_DELAY_SECONDS=20.0

# Stale-posting / dead-apply-link detection
# (src/application/use_cases/detect_stale_job_postings.py). Runs every 6h
# via Celery beat to flag postings too old (STALE) or whose apply_url no
# longer resolves (DEAD_LINK), keeping both out of the active job set.
APPLY_URL_CHECK_TIMEOUT_SECONDS=10.0
STALE_POSTING_AFTER_DAYS=45
STALE_POSTING_RECHECK_AFTER_DAYS=3
STALE_POSTING_DEAD_LINK_AFTER_FAILURES=3
STALE_POSTING_SWEEP_BATCH_SIZE=200

# Job requirements extraction (Epic 03 —
# src/application/use_cases/extract_job_requirements.py). Runs every 10m
# via Celery beat to keep newly ingested postings' `requirements` populated.
JOB_REQUIREMENTS_SWEEP_BATCH_SIZE=200

# Browser automation for application portals (Epic 05 —
# src/infrastructure/browser_automation/). Drives a real Chromium over a
# posting's apply_url to read and fill its form. No API and no credential —
# the "endpoint" is whatever HTML the portal serves. Requires the Chromium
# build Playwright expects: `playwright install chromium`.
BROWSER_HEADLESS=true
BROWSER_NAVIGATION_TIMEOUT_SECONDS=30.0
BROWSER_ACTION_TIMEOUT_SECONDS=10.0
BROWSER_SETTLE_TIMEOUT_SECONDS=5.0
BROWSER_FIELD_WAIT_TIMEOUT_SECONDS=5.0
BROWSER_NAVIGATION_MAX_RETRIES=1
BROWSER_NAVIGATION_RETRY_BASE_DELAY_SECONDS=1.0
BROWSER_NAVIGATION_RETRY_MAX_DELAY_SECONDS=8.0
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=900
# Left empty so Chromium reports its own real user agent.
BROWSER_USER_AGENT=
# JSON list of extra Chromium flags. Containers usually cannot use
# Chromium's sandbox: BROWSER_LAUNCH_ARGS=["--no-sandbox"]
BROWSER_LAUNCH_ARGS=[]

# Review-and-submit (Epic 05 —
# src/application/services/application_review_sessions.py). A filled
# application form stays open in a browser while the candidate reviews it and
# decides whether to submit. How long one abandoned review holds that browser,
# and how many this process holds at once. Both are resource ceilings: each
# parked review is a browser context. Reviews are process-local, so an API
# served by several workers needs sticky routing for this flow.
AUTOFILL_REVIEW_TTL_SECONDS=900.0
AUTOFILL_MAX_PARKED_REVIEWS=8

# -- Privacy notice ----------------------------------------------------------
# The version of the privacy notice this deployment serves. Stamped onto every
# consent decision (see src/domain/value_objects/consent_decision.py), which is
# what makes the recorded consent demonstrably *informed*: consent is only valid
# for what the user was actually told, so a materially changed notice
# invalidates consent collected under the old version. Bump this when the notice
# changes materially — that is what turns "who has to be re-asked?" into a query
# instead of a guess (GDPR Art. 7(1)).
# Date-stamped by convention so it sorts and stays recognizable in a ledger row
# read years later. Not a secret.
PRIVACY_POLICY_VERSION=2026-08-03
